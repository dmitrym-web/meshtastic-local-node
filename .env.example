# MQTT-брокер
MQTT_BROKER=meshtastic.meshradio.online
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_ROOT_TOPIC=msh/nvrsk

# Канал
CHANNEL=LongFast
CHANNEL_KEY=AQ==
CHANNEL_KEY_DIRECT=1PG7OiApB1nwvP+rz05pAQ==
CHANNEL_INDEX=0

# Нода и пути
SERIAL_PORT=/dev/ttyACM0
NODE_ID=
VN_HOST=localhost
JOBS_DIR=/app/jobs
NODES_CACHE_FILE=/data/nodes.json

# Порты
SERIAL_BRIDGE_PORT=4403
MESHMONITOR_PORT=8181
MESHMONITOR_VIRTUAL_NODE_PORT=4404

# Фильтры логов (true / false)
LOG_TEXT=true
LOG_POSITION=true
LOG_TELEMETRY=false
LOG_NODEINFO=true

# Таймзона
TZ=Europe/Moscow

# Права пользователя для контейнеров
PUID=1000
PGID=1000

# Бэкапы
BACKUP_KEEP_DAYS=7

# Сторож MQTT-соединения
MQTT_WATCHDOG_ENABLED=true
MQTT_WATCHDOG_TIMEOUT=300
MQTT_RECONNECT_MAX_DELAY=10
MQTT_KEEPALIVE=10
WATCHDOG_CHECK_INTERVAL=1

# Отправка сообщений
MAX_MESSAGE_BYTES=150
MESSAGE_CHUNK_DELAY=5
SEND_CLOSE_DELAY=2

# Планировщик
SCHEDULER_SYNC_INTERVAL=2