# MQTT-брокер
MQTT_BROKER=meshtastic.meshradio.online
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_ROOT_TOPIC=msh/nvrsk

# Канал
CHANNEL=LongFast
CHANNEL_KEY=AQ==
CHANNEL_INDEX=0

# Нода
SERIAL_PORT=/dev/ttyACM0
NODE_ID=

# Порты
SERIAL_BRIDGE_PORT=4403
MESHMONITOR_PORT=8181
MESHMONITOR_VIRTUAL_NODE_PORT=4404